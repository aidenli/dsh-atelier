      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Event"
                  },
                  "type": "array"
                }
              }
            },
            "description": "成功"
          },
          "400": {
            "description": "参数、业务或版本冲突"
          }
        },
        "summary": "事件游标或待投递通知"
      }
    },
    "/events/{seq}/ack": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "seq",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数、业务或版本冲突"
          }
        },
        "summary": "确认通知持久化"
      }
    },
    "/health": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "成功"
          },
          "400": {
            "description": "参数、业务或版本冲突"
          }
        },
        "summary": "连接检查及后端能力"
      }
    },
    "/tasks": {
      "get": {
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数、业务或版本冲突"
          }
        },
        "summary": "分页筛选任务与汇总"
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            },
            "description": "成功"
          },
          "400": {
            "description": "参数、业务或版本冲突"
          }
        },
        "summary": "幂等创建批次"
      }
    },
    "/tasks/{id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
